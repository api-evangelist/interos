{
  "opencollection": "1.0.0",
  "info": {
    "name": "Interos Groups health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate that a developer api-key is still active",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.interos.ai/health",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Validate a developer api-key"
        }
      ]
    }
  ],
  "bundled": true
}